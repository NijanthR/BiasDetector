# FastAPI & Server Settings
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (SQLite default for local, or Render PostgreSQL URL)
DATABASE_URL=sqlite:///./db.sqlite3
# For Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CORS Configuration (comma-separated origins, e.g. your Vercel domain and localhost)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-app.vercel.app

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=groq/openai/gpt-oss-120b

# CrewAI Settings
CREWAI_API_KEY=your_crewai_api_key_here
LANGCHAIN_API_KEY=your_langchain_api_key_here

# API Settings
API_TIMEOUT=300
LOG_LEVEL=INFO
